{
  "interactions": [
    {
      "target_id": "nav",
      "type": "menu_toggle"
    },
    {
      "target_id": "contact",
      "type": "form_validate"
    }
  ],
  "language": "id",
  "schema_version": "1.0",
  "style_mode": "tailwind",
  "theme": {
    "background": "#ffffff",
    "font": "sans",
    "primary": "#10b981",
    "text": "#111827"
  },
  "sections": [
    {
      "id": "nav",
      "props": {
        "brand": "Studio Bagreenlo",
        "links": [
          {
            "href": "#main",
            "label": "Beranda"
          }
        ]
      },
      "type": "navbar"
    },
    {
      "id": "main",
      "props": {
        "heading": "Studio Bagreenlo",
        "layout": "centered",
        "text": "Bersama membangun pengalaman terbaik."
      },
      "type": "hero"
    },
    {
      "id": "pricing",
      "props": {
        "heading": "Paket",
        "plans": [
          {
            "features": [
              "Layanan dasar"
            ],
            "name": "Dasar",
            "price": "Rp49.000"
          },
          {
            "features": [
              "Layanan lengkap"
            ],
            "name": "Plus",
            "price": "Rp99.000"
          }
        ]
      },
      "type": "pricing_table"
    },
    {
      "id": "contact",
      "props": {
        "fields": [
          {
            "label": "Nama",
            "name": "nama",
            "type": "text"
          },
          {
            "label": "Email",
            "name": "email",
            "type": "email"
          },
          {
            "label": "Pesan",
            "name": "pesan",
            "type": "textarea"
          }
        ],
        "heading": "Hubungi Kami",
        "submit_label": "Kirim"
      },
      "type": "contact_form"
    },
    {
      "id": "footer",
      "props": {
        "text": "Studio Bagreenlo"
      },
      "type": "footer"
    }
  ],
  "title": "Studio Bagreenlo"
}
